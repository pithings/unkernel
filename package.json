{
  "name": "unkernel",
  "version": "0.2.0",
  "description": "Linux on WebAssembly: boot Alpine, Debian or your own aarch64 Linux userland in Node or the browser",
  "license": "MIT AND GPL-2.0-only",
  "author": "Pooya Parsa <pooya@pi0.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pithings/unkernel.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "node": {
        "types": "./dist/node.d.mts",
        "default": "./dist/node.mjs"
      },
      "default": {
        "types": "./dist/web.d.mts",
        "default": "./dist/web.mjs"
      }
    },
    "./node": {
      "types": "./dist/node.d.mts",
      "default": "./dist/node.mjs"
    },
    "./web": {
      "types": "./dist/web.d.mts",
      "default": "./dist/web.mjs"
    },
    "./unkernel.wasm": "./dist/unkernel.wasm",
    "./virgl.mjs": "./dist/virgl.mjs",
    "./virgl.wasm": "./dist/virgl.wasm",
    "./kwvk-naga.wasm": "./dist/kwvk-naga.wasm",
    "./package.json": "./package.json"
  },
  "types": "./dist/node.d.mts",
  "bin": {
    "unkernel": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE-MIT",
    "THIRD-PARTY.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "obuild",
    "typecheck": "tsc -p .",
    "test": "pnpm typecheck && pnpm test:block && pnpm test:net && pnpm test:tty && pnpm test:guest-files && pnpm test:http && pnpm test:ws && pnpm test:9p && pnpm test:distro && pnpm test:gl-gpu && pnpm test:vk && pnpm test:va && pnpm test:audio",
    "test:block": "node --test test/block.test.ts",
    "test:net": "node --test test/net.test.ts",
    "test:tty": "node --test test/tty.test.ts",
    "test:guest-files": "node --test test/guest-files.test.ts",
    "test:9p": "node --test test/9p.test.ts",
    "test:http": "node --test test/http.test.ts",
    "test:ws": "node --test test/ws.test.ts",
    "test:kpatch": "node --test test/kpatch.test.ts",
    "test:profile": "node --test test/profile.test.ts",
    "test:wasi": "node test/wasi-node.ts",
    "test:api": "node --test test/api.test.ts",
    "test:distro": "node --test test/distro.test.ts",
    "test:gl-gpu": "node --test test/gl-gpu.test.ts",
    "test:vk": "node --test test/vk.test.ts",
    "test:va": "node --test test/va.test.ts test/va-h264.test.ts test/va-decoders.test.ts test/va-av1.test.ts test/va-frames.test.ts test/va-enc.test.ts",
    "test:audio": "node --test test/audio.test.ts",
    "unkernel": "node js/cli.ts",
    "dev": "pnpm -C web dev",
    "build:web": "pnpm -C web build",
    "start:web": "pnpm -C web start",
    "typecheck:web": "pnpm -C web typecheck",
    "test:web": "node web/test/headless.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "obuild": "^0.4.45",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.14.0"
}
