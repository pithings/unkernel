// Storage texel buffers: read and written with a format, written without
// one, image atomics (unsigned and signed), imageSize, and a store past
// the end (dropped).
#extension GL_EXT_shader_image_load_formatted : require
layout(local_size_x = 16) in;
layout(set = 0, binding = 0, rgba32f) uniform imageBuffer img;
layout(set = 0, binding = 1) uniform writeonly uimageBuffer wo;
layout(set = 0, binding = 2, r32ui) uniform uimageBuffer counter;
layout(set = 0, binding = 3, r32i) uniform iimageBuffer imax;
layout(set = 0, binding = 4) uniform readonly iimageBuffer ro;
void main() {
	int n = int(gl_GlobalInvocationID.x);
	vec4 v = imageLoad(img, n);
	imageStore(img, n, v * 2.0 + vec4(1.0));
	imageStore(wo, n, uvec4(n, n * 2, n * 3, 255 - n) + uvec4(imageLoad(ro, n)));
	imageAtomicAdd(counter, n % 4, 1u);
	imageAtomicMax(imax, 0, n - 8);
	if (n == 0)
		imageStore(wo, 100, uvec4(imageSize(img)));
}
