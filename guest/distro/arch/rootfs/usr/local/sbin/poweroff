# poweroff under kw-init: SIGUSR1 to PID 1; another user through sudo -n.

# unkernel: poweroff under kw-init.
trap 'exit 0' TERM   # kw-init stops everything: no "Terminated"
if [ "$(id -u)" != 0 ]; then
	sudo -n /usr/local/sbin/poweroff "$@"
	exit
fi
kill -USR1 1
sleep 10
